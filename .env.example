# ==========================================
# IT Company WhatsApp Campaign Manager Config
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Single Administrator Credentials (Phase 2)
ADMIN_EMAIL=admin@itcompany.com
ADMIN_PASSWORD=Admin@123456
ADMIN_PASSWORD_HASH=
JWT_SECRET=it-company-whatsapp-campaign-manager-jwt-access-secret-2026
JWT_REFRESH_SECRET=it-company-whatsapp-campaign-manager-jwt-refresh-secret-2026

# Permanent MongoDB Database Connection (Remote Atlas or Local)
MONGODB_URI=mongodb://127.0.0.1:27017/whatsapp_campaign_manager

# Official WhatsApp Business Cloud API Credentials (Phase 5)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_API_VERSION=v18.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=it-company-whatsapp-webhook-verify-2026
WHATSAPP_APP_SECRET=your_whatsapp_app_secret

# Controlled Sending Engine Concurrency & Retries
WHATSAPP_SEND_CONCURRENCY=5
WHATSAPP_MAX_RETRIES=3

# Rate Limiting Configuration
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
